  "voice": {
    "brief-1": {
      "file": "audio/voice/brief-1.mp3",
      "gain": 1.244,
      "seconds": 8.67,
      "speaker": "AKSE",
      "text": "Captain. The Directorate pushed a recon group into Marrow Yard before dawn. Five walkers, dug in among the freight lines."
    },
    "brief-2": {
      "file": "audio/voice/brief-2.mp3",
      "gain": 1.313,
      "seconds": 7.89,
      "speaker": "AKSE",
      "text": "That yard is the only rail link into Kerrow. The Concord wants it open before the supply train arrives at noon."
    },
    "brief-3": {
      "file": "audio/voice/brief-3.mp3",
      "gain": 1.371,
      "seconds": 6.09,
      "speaker": "AKSE",
      "text": "Clear every Directorate walker from the yard. Their commander will be sitting by the grain silos."
    },
    "brief-4": {
      "file": "audio/voice/brief-4.mp3",
      "gain": 1.06,
      "seconds": 5.2,
      "speaker": "MARLOW",
      "text": "Understood. Varga takes the left track. Okonjo and Haldane come up the middle with me."
    },
    "brief-5": {
      "file": "audio/voice/brief-5.mp3",
      "gain": 1.387,
      "seconds": 7.13,
      "speaker": "AKSE",
      "text": "One more thing. Whatever you strip off their machines is yours. Salvage rights are in the contract."
    },
    "brief-6": {
      "file": "audio/voice/brief-6.mp3",
      "gain": 1.09,
      "seconds": 2.59,
      "speaker": "MARLOW",
      "text": "Then let's go earn it. Lanterns, move out."
    },
    "intercept": {
      "file": "audio/voice/intercept.mp3",
      "gain": 1.111,
      "seconds": 4,
      "speaker": "HALLEN",
      "text": "Contract dogs. Hold the silos and let them come to us."
    },
    "debrief-win": {
      "file": "audio/voice/debrief-win.mp3",
      "gain": 1.464,
      "seconds": 7.6,
      "speaker": "AKSE",
      "text": "The yard is ours, and the train comes through at noon. Good work, Captain. Your salvage is on the flatbeds."
    },
    "debrief-lose": {
      "file": "audio/voice/debrief-lose.mp3",
      "gain": 1.28,
      "seconds": 3.58,
      "speaker": "AKSE",
      "text": "Pull back, Captain. We'll find another way into Kerrow."
